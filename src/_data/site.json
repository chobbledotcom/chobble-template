{
	"name": "Chobble Template",
	"url": "https://example.chobble.com",
	"description": "A static-site template for informational and marketing sites.",
	"socials": {
		"Github": "https://github.com/chobbledotcom/chobble-template",
		"RSS": "/feed.xml"
	},
	"cms_config": {
		"collections": [
			"pages",
			"news",
			"products",
			"guide-categories",
			"guide-pages",
			"snippets"
		],
		"features": {
			"permalinks": true,
			"redirects": true,
			"faqs": true,
			"galleries": true,
			"external_navigation_urls": true,
			"no_index": true
		},
		"hasSrcFolder": true,
		"customBlocksCollections": []
	}
}
